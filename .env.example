PORT=3000
HOST=127.0.0.1
API_BASE_PATH=/api
USER_DATA_FILE=data/users.json
DATABASE_FILE=data/careerconnect.sqlite
PASSWORD_SCRYPT_N=16384
PASSWORD_KEY_LENGTH=64
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_MS=900000
REQUEST_MAX_BYTES=32768
# Server-only OpenAI settings for the optional resume feedback tool.
# Never put OPENAI_API_KEY in frontend files or commit a populated .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_REQUEST_TIMEOUT_MS=20000

PORT=3000
HOST=127.0.0.1
API_BASE_PATH=/api
# Server-only Supabase connection string: Connect > Session pooler.
# URL-encode special characters in the password. Never commit a populated value.
DATABASE_URL=
# Optional downloaded Supabase CA certificate path for verified TLS.
DATABASE_CA_FILE=
# Optional public API settings; the Node backend uses DATABASE_URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PASSWORD_SCRYPT_N=16384
PASSWORD_KEY_LENGTH=64
AUTH_MAX_ATTEMPTS=10
AUTH_WINDOW_MS=900000
REQUEST_MAX_BYTES=32768
# Server-only OpenAI settings for the optional resume feedback tool.
# Never put OPENAI_API_KEY in frontend files or commit a populated .env file.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_REQUEST_TIMEOUT_MS=20000
